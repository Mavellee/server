# ---- Core ----
NODE_ENV=development
PORT=4000
# Public origin of the web app (used for CORS, CSRF Origin checks and links in emails)
APP_ORIGIN=http://localhost:5180
DATABASE_URL=postgresql://knot:knot_dev_password@localhost:5433/knot
# Used only by `npm test`
TEST_DATABASE_URL=postgresql://knot:knot_dev_password@localhost:5433/knot_test

# ---- Sessions ----
SESSION_TTL_DAYS=30
# ---- Sign-in tokens ----
# Access tokens are 15-minute EdDSA JWTs; refresh tokens rotate on every use.
# Generate the signing key once and keep it secret (never commit it):
#   openssl genpkey -algorithm ed25519 | base64 | tr -d '\n'
# Without it, development uses a temporary key per process (people stay signed in through their refresh token).
# Production refuses to start without it.
AUTH_JWT_PRIVATE_KEY=
AUTH_ISSUER=mavelle-api
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_IDLE_DAYS=7
# Set to true behind HTTPS (production). Forces Secure cookies.
COOKIE_SECURE=false
# Number of reverse proxies in front of the app (Caddy = 1)
TRUST_PROXY=0

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# Profile videos: upload size (MB) and length (seconds) limits
VIDEO_MAX_MB=50
VIDEO_MAX_SECONDS=30

# ---- Email (leave SMTP_HOST empty to log emails to the console in development) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mavelle <hello@example.com>"

# ---- Mavelle AI (optional — the app works with AI_PROVIDER=none) ----
# none | ollama | openai-compatible
AI_PROVIDER=none
AI_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
# For openai-compatible hosted APIs (never exposed to the browser)
AI_API_URL=
AI_API_KEY=
AI_TIMEOUT_MS=12000
AI_REVIEW_TIMEOUT_MS=30000
AI_MAX_OUTPUT_CHARS=600
AI_MAX_CONCURRENCY=2
AI_DAILY_USER_LIMIT=20
AI_DAILY_GLOBAL_LIMIT=2000

# ---- Mavelle Astro (optional) ----
# 32 random bytes, base64: openssl rand -base64 32. Without it Mavelle Astro stays off; matches and chat are unaffected.
# Back it up: losing it makes stored birth details unreadable.
ASTRO_ENCRYPTION_KEY=
# For AI_PROVIDER=openai, gemini or anthropic, set AI_MODEL and only the key for that provider. Keys stay on the server.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ASTRO_RETENTION_DAYS=365
ASTRO_AI_TIMEOUT_MS=45000
ASTRO_MONTHLY_REPORT_LIMIT=200
ASTRO_USER_DAILY_LIMIT=5

# ---- Compatibility weights (0-10 each) ----
COMPAT_WEIGHT_RELATIONSHIP_GOALS=5
COMPAT_WEIGHT_COMMUNICATION=3
COMPAT_WEIGHT_LIFESTYLE=3
COMPAT_WEIGHT_INTERESTS=2
COMPAT_WEIGHT_VALUES=4

LOG_LEVEL=info
